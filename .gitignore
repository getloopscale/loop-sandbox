node_modules/
dist/
bin/
*.log
.DS_Store
.env

# Terraform provider cache + state (keep .terraform.lock.hcl)
deployments/terraform/**/.terraform/
deployments/terraform/**/*.tfstate*

# Claude Code cycle kit — versioned (skills/rules/hooks/commands/scripts + settings).
# Only caches and large/generated artifacts underneath are ignored.
.claude/**/__pycache__/
.claude/**/*.pyc
.claude/knowledge-base/references/**
.claude/knowledge-base/tools/**
# SOTA reference peer clones (study material, third-party) — the tracked catalog is the
# SOTA references table in ROADMAP-v2.md, not the clones themselves.
knowledge-base/references/
.claude/knowledge-base/discoveries/snapshots/**
.claude/agents/**

# build artifact (injected into rootfs by scripts/fc-rootfs.sh)
/lsb-agent

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Compiled SDK test server
/testserver

# Generated by make sbom
/sbom/

{
  "name": "loopsandbox",
  "version": "0.1.0",
  "description": "TypeScript SDK for LoopScale code sandboxes: run untrusted code in an isolated sandbox.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/getloopscale/loop-sandbox#sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getloopscale/loop-sandbox.git",
    "directory": "sdk/javascript"
  },
  "bugs": {
    "url": "https://github.com/getloopscale/loop-sandbox/issues"
  },
  "keywords": [
    "sandbox",
    "code-interpreter",
    "loopscale",
    "ai-agents",
    "e2b"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0"
  }
}
